[
  {
    "plugin_id": "husam.vim-navigator",
    "name": "Vim Navigator",
    "version": "0.1.0",
    "min_herdr_version": "0.8.0",
    "description": "vim-tmux-navigator style smart pane navigation for Herdr",
    "manifest_path": "/home/husam/dotfiles/herdr/plugins/vim-navigator/herdr-plugin.toml",
    "plugin_root": "/home/husam/dotfiles/herdr/plugins/vim-navigator",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "down",
        "title": "Smart focus down",
        "command": [
          "bash",
          "nav.sh",
          "down"
        ]
      },
      {
        "id": "left",
        "title": "Smart focus left",
        "command": [
          "bash",
          "nav.sh",
          "left"
        ]
      },
      {
        "id": "right",
        "title": "Smart focus right",
        "command": [
          "bash",
          "nav.sh",
          "right"
        ]
      },
      {
        "id": "up",
        "title": "Smart focus up",
        "command": [
          "bash",
          "nav.sh",
          "up"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]